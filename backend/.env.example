# Copy to .env and fill in. Nothing database-related belongs here: DATABASE_URL
# defaults to the compose database, and the app_user connection is derived from
# it. See docs/development.md.

# Signs the session cookie. Any random string locally.
SESSION_SECRET=

# Your own Google OAuth client — see the "Google OAuth setup" section of
# docs/development.md for how to create one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated. Only these addresses can log in; the app is invite-only.
ALLOWED_EMAILS=

# Book search does not work without your own key. Unkeyed requests share a
# single global quota across every anonymous caller, so it is always
# exhausted. The code omits the key when unset rather than erroring, so the
# failure looks like "search returns nothing" rather than an auth error.
GOOGLE_BOOKS_API_KEY=

# Enables POST /auth/test-login, which skips Google entirely. Needed for
# scripts/seed_dev.py to authenticate. NEVER set this in production — it is an
# unauthenticated way to log in as any allowlisted user.
ALLOW_TEST_LOGIN=true
