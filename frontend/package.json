{
  "name": "reading-tracker-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "prettier:check": "prettier --check . ../docs",
    "prettier:format": "prettier --write . ../docs",
    "typecheck": "tsc -b --noEmit",
    "generate:api": "orval --config orval.config.ts",
    "prestorybook": "rm -f documentation.json",
    "storybook": "ng run reading-tracker-app:storybook",
    "prebuild-storybook": "rm -f documentation.json",
    "build-storybook": "ng run reading-tracker-app:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "lint-staged": {
    "*.{ts,html,css,scss,json,md}": "prettier --write",
    "*.{ts,html}": "eslint --fix"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/angular": "^19.4.1",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.7",
    "orval": "^8.22.0",
    "postcss": "^8.5.19",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8",
    "storybook": "^10.5.5",
    "@storybook/angular-vite": "^10.5.5",
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-onboarding": "^10.5.5",
    "@types/node": "^20",
    "@angular-devkit/build-angular": "^22.1.0",
    "@angular-devkit/architect": "^0.2201.0",
    "@angular-devkit/core": "^22.1.0",
    "@angular/animations": "^22.1.0",
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "vite": "^8.2.0",
    "@compodoc/compodoc": "^2.0.0",
    "eslint-plugin-storybook": "^10.5.5",
    "@vitest/browser-playwright": "4.1.9",
    "playwright": "^1.62.1"
  }
}
