// Tells VS Code that this project's real environment is the `workspace`
// container. "Reopen in Container" moves the language servers, extensions,
// terminal and debugger inside it; the UI stays native on the Mac.
{
  "name": "reading-tracker",
  "dockerComposeFile": "../compose.yaml",
  "service": "workspace",

  // The repo is bind-mounted at its own host path (see compose.yaml), so the
  // folder to open inside the container is the same path VS Code opened on the
  // Mac. Not the conventional /workspaces/<name>.
  "workspaceFolder": "${localWorkspaceFolder}",

  // Leave the workspace service's own command alone. If VS Code replaced it
  // with `sleep infinity` — which it does for image-based devcontainers — the
  // `pre-commit install` in that command would silently stop running.
  "overrideCommand": false,

  // Closing the VS Code window leaves the stack up. The default for a compose
  // devcontainer is "stopCompose", which takes the app and database down with
  // the editor; `docker compose down` should be something done deliberately.
  "shutdownAction": "none",

  // VS Code auto-forwards a local SSH agent into the container and points
  // SSH_AUTH_SOCK at its own forwarding socket, overriding the value
  // compose.yaml already sets for the workspace service. Its forwarding has
  // nothing to forward from, since 1Password exposes itself via ssh_config's
  // IdentityAgent rather than a host-side SSH_AUTH_SOCK env var, so the
  // result is a live socket with no identities. remoteEnv re-asserts the
  // working socket for the whole remote session — terminals, tasks, and the
  // Source Control panel's own git calls alike — not just interactive shells.
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/tmp/1password-agent.sock"
  },

  "customizations": {
    "vscode": {
      "settings": {
        // The container's interpreter, and the only one set anywhere.
        // .vscode/settings.json deliberately sets none: workspace settings
        // outrank these, so a value there would override this one inside the
        // container.
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      // Extensions do not carry in from the Mac — they install into the
      // container, so the list has to exist here. This duplicates
      // .vscode/extensions.json, which only *recommends*; this one installs.
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "eamodio.gitlens",
        "rangav.vscode-thunder-client",
        "esbenp.prettier-vscode",
        "angular.ng-template"
      ]
    }
  }
}
