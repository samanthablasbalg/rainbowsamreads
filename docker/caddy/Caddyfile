:8080 {
	handle /api/* {
		reverse_proxy api:8000
	}

	# frontend's dev server checks the Host header against its allowedHosts
	# config (["frontend"] in vite.config.ts). Rewriting it here means that stays
	# true no matter what hostname a client used to reach this proxy, so the dev
	# server never has to change when the proxy is addressed differently (a new
	# published port, a different compose project name in CI).
	handle {
		reverse_proxy frontend:5173 {
			header_up Host frontend:5173
		}
	}
}
